predic_w_gamma_am <- function(sd_l,mean_l,lod)
{
t <- sd_l/mean_l
a <- 1E-3*(1482-9.166*lod)
b <- -1E-3*(166+2.569*lod)
a*t^b
}
predic_w_gamma_gm <- function(sd_l,mean_l,lod)
{
t <- sd_l/mean_l
a <- 1E-2*(142.327 - 1.098*lod)
b <- -1E-3*(202.6 +3.906*lod)
a*t^b
}
