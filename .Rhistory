data <- generate_data(true_alpha, true_beta, n, LOD)
# 使用替换法计算先验参数
prior_params <- compute_prior_params(data,LOD)
mean_alpha <- prior_params$mean^2/prior_params$var
sd_alpha <- 1
mean_beta <-  prior_params$mean/prior_params$var
sd_beta <- 1
# MAP估计
estimates_map <- map_estimate(data, mean_alpha, sd_alpha, mean_beta, sd_beta)
cat("MAP估计:\n")
cat("Alpha =", estimates_map[1], "\n")
cat("Beta =", estimates_map[2], "\n")
# 定义MLE估计的函数
mle_estimate <- function(data) {
# 包装目标函数，使其只接受待优化的参数
objective <- function(params) {
alpha <- params[1]
beta <- params[2]
- likelihood(alpha, beta, data)
}
initial_params <- c(1, 1)
fit <- optim(par = initial_params, fn = objective, method = "L-BFGS-B", lower = c(0.01, 0.01))
return(fit$par)
}
# MLE估计
estimates_mle <- mle_estimate(data)
cat("\nMLE估计:\n")
cat("Alpha =", estimates_mle[1], "\n")
cat("Beta =", estimates_mle[2], "\n")
# MAP估计
estimates_map <- map_estimate(data, mean_alpha, sd_alpha, mean_beta, sd_beta)
cat("MAP估计:\n")
cat("Alpha =", estimates_map[1], "\n")
cat("Beta =", estimates_map[2], "\n")
