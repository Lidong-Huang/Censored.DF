predic_w_gamma_am <- function(sd_l,mean_l,lod)
{
t <- sd_l/mean_l
a <- 1.215E-4*lod^2-1.315E-2*lod+2.339
b <- -1.652E-4*lod^2-5.432E-4*lod-0.8939
a * exp(b*t)
}
predic_w_gamma_gm <- function(sd_l,mean_l,lod)
{
t <- sd_l/mean_l
a <- 1.403E-4*lod^2-1.236E-2*lod+2.924
b <- -2.253E-4*lod^2-1.111E-2*lod-1.421
a * exp(b*t)
}
