)
)
# Server部分
server <- function(input, output) {
instructions_text <- "
> This app is designed for testing the statistical distribution (Lognormal or Gamma) of left censored data.\n
> This app only accepts csv format file.\n
> The dataset should only contain two columns. The first column is numeric value in which censored value is replaced by detection limit. The second column is logical value (TRUE for the censored, FALSE for the detected).\n
> You can download the example Lognormal data (right side) as a template. In this example, the detection limit is 0.828.\n
> Upload your data in the 'Upload File' menu.\n
> After uploading your data, if everything is right, click 'Start Fitting!' in the 'Upload File' menu and the fitting results will be shown in 'Summary of Fitting' and 'CDF & Q-Q Plot'.\n
> The core functions are from package {EnvStats}. Function 'gofTestCensored' is used to do goodness-of-fit. 'cdfCompareCensored' and 'qqPlotCensored' are applied to plot the CDF and Q-Q graphs. The app is developed by Lidong Huang, copyright (c) reserved 2024.
"
output$instructions <- renderText(instructions_text)
}
# 运行应用程序
shinyApp(ui = ui, server = server)
