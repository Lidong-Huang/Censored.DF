colnames(source_profiles) <- paste("Element", 1:n_elements, sep = "_")
View(source_profiles)
# 假设每个样本是5个污染源的混合，每个源的贡献不同
contributions <- matrix(runif(n_samples * n_sources, 0, 1), ncol = n_sources)
contributions <- t(apply(contributions, 1, function(x) x / sum(x)))
contributions
View(contributions)
# 生成样本数据
sample_data <- contributions %*% source_profiles + matrix(rnorm(n_samples * n_elements, 0, 0.01), ncol = n_elements)
View(source_profiles)
View(sample_data)
# 定义贝叶斯模型
stan_code <- "
data {
int<lower=1> N; // 样本数
int<lower=1> S; // 污染源数
int<lower=1> E; // 元素数
matrix[N, E] Y; // 样本数据
matrix[S, E] profiles; // 污染源指纹图谱
}
parameters {
simplex[S] theta[N]; // 每个样本的污染源贡献
real<lower=0> sigma; // 观测误差
}
model {
for (n in 1:N)
Y[n] ~ normal(profiles' * theta[n], sigma);
}
"
# 准备数据
stan_data <- list(N = n_samples, S = n_sources, E = n_elements, Y = sample_data, profiles = source_profiles)
# 编译和拟合模型
fit <- stan(model_code = stan_code, data = stan_data, iter = 2000, chains = 4)
# 编译和拟合模型
fit <- stan(model_code = stan_code, data = stan_data, iter = 2000, chains = 4)
